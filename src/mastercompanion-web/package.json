{
  "name": "mastercompanion-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "check:quality": "node tools/check-quality.mjs",
    "start": "node tools/start.mjs",
    "build": "node tools/build.mjs",
    "prepare:ythryn": "node tools/prepare-module.mjs ../MasterCompanion.Modules.Ythryn/Data/Source ../MasterCompanion.Modules.Ythryn/Data/Generated/pilot.json",
    "import:ythryn-poc": "node tools/import-ythryn-poc.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check:code": "node tools/check-code-policy.mjs",
    "check:ui": "tsc --project e2e/tsconfig.json --noEmit",
    "test:ui": "playwright test",
    "test:ui:server": "tsx --tsconfig tsconfig.tests.json --test tests/integration/ui-server.test.mjs",
    "test:ui:update": "playwright test --grep @visual --update-snapshots=all",
    "test:ui:report": "playwright show-report .local/ui-report",
    "test:content": "tsx --tsconfig tsconfig.tests.json --test tests/integration/content.test.mjs tests/integration/module-sources.test.mjs",
    "test:notes": "tsx --tsconfig tsconfig.tests.json --test tests/unit/material-creation.test.mjs tests/unit/workspace-notes.test.ts",
    "test:autosave": "tsx --tsconfig tsconfig.tests.json --test tests/unit/autosave.test.ts tests/integration/material-editor.test.mjs",
    "test:editor": "tsx --tsconfig tsconfig.tests.json --test tests/integration/editor-insertion.test.mjs",
    "test:gameplay": "tsx --tsconfig tsconfig.tests.json --test tests/unit/gameplay-session.test.mjs tests/unit/blight-view.test.mjs tests/unit/expedition-view.test.mjs tests/unit/rival-forces.test.ts tests/integration/expedition-tool.test.mjs",
    "test:api": "node tools/verify-api.mjs",
    "test:api-errors": "node tools/verify-api.mjs --errors-only",
    "test:unit": "tsx --tsconfig tsconfig.tests.json --test tests/unit/*.test.*",
    "test:integration": "tsx --tsconfig tsconfig.tests.json --test tests/integration/*.test.mjs",
    "check:format": "prettier --check projects src tests tools e2e *.json *.ts *.mjs",
    "format": "prettier --write projects src tests tools e2e *.json *.ts *.mjs",
    "check:lint": "eslint projects src tests e2e",
    "check:tests": "tsc --project tests/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "markdown-it": "15.0.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@playwright/test": "1.63.0",
    "@tiptap/html": "3.31.4",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.3",
    "eslint": "10.12.0",
    "happy-dom": "20.8.9",
    "ng-packagr": "22.2.3",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "yaml": "2.9.1"
  }
}
