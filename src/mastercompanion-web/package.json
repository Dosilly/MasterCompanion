{
  "name": "mastercompanion-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "start": "node tools/start.mjs",
    "build": "node tools/build.mjs",
    "prepare:ythryn": "node tools/prepare-module.mjs ../MasterCompanion.Modules.Ythryn/Data/Source ../MasterCompanion.Modules.Ythryn/Data/Generated/pilot.json",
    "import:ythryn-poc": "node tools/import-ythryn-poc.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check:code": "node tools/check-code-policy.mjs",
    "check:ui": "tsc --project e2e/tsconfig.json --noEmit",
    "test:ui": "playwright test",
    "test:ui:server": "node --test tools/ui-server.test.mjs",
    "test:ui:update": "playwright test --grep @visual --update-snapshots=all",
    "test:ui:report": "playwright show-report .local/ui-report",
    "test:content": "node --test tools/content.test.mjs tools/module-sources.test.mjs",
    "test:autosave": "node --test tools/autosave.test.mjs tools/material-editor.test.mjs",
    "test:editor": "node --test tools/editor-insertion.test.mjs",
    "test:gameplay": "node --test tools/gameplay-session.test.mjs tools/blight-view.test.mjs tools/expedition-view.test.mjs tools/expedition-tool.test.mjs",
    "test:api": "node tools/verify-api.mjs",
    "test:api-errors": "node tools/verify-api.mjs --errors-only"
  },
  "dependencies": {
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "markdown-it": "15.0.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@playwright/test": "1.63.0",
    "@tiptap/html": "3.31.4",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.3",
    "happy-dom": "20.8.9",
    "ng-packagr": "22.2.3",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
